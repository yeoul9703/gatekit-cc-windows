# gatekit runtime state (machine-local, created while using gatekit commands)
.gatekit/runs/
.gatekit/jobs/

# Python bytecode caches
__pycache__/
*.pyc

# Claude Code local overrides (not shared)
.claude/settings.local.json

# Scratch notes (tasks, eval criteria)
tmp/

# uv virtualenv (created by scripts/setup.ps1 / uv sync)
.venv/

# hypothesis example cache (property tests, dev group only)
.hypothesis/
