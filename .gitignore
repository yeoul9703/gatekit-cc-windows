# gatekit state: everything under .gatekit/ stays on this machine, except what has to travel.
# approvals.json: an approval must hold on another PC. contract.json: without it the stop
# gate has nothing to enforce. config.json: present only when someone changed a setting.
.gatekit/*
!.gatekit/approvals.json
!.gatekit/contract.json
!.gatekit/config.json

# Python bytecode caches
__pycache__/
*.pyc

# Claude Code local overrides (not shared)
.claude/settings.local.json

# Scratch notes (tasks, eval criteria)
tmp/

# uv virtualenv (created by scripts/setup.ps1 / uv sync)
.venv/

# hypothesis example cache (property tests, dev group only)
.hypothesis/
